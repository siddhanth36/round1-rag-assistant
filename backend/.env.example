# INDUSTRIX AI environment template. Copy to backend/.env (git-ignored) and fill in locally.
# Placeholders only. Never commit real values.

# --- Django (required) ---
SECRET_KEY=<long-random-string>
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Supabase PostgreSQL via the SESSION POOLER (port 5432, IPv4), with SSL. No SQLite fallback exists.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# --- Django (optional) ---
# HTTPS-only cookies. Defaults to the opposite of DEBUG; set True when served over HTTPS.
SECURE_COOKIES=False
# Uploaded manuals. Empty = <repo>/media (git-ignored). Never served publicly.
MEDIA_ROOT=
MAX_UPLOAD_MB=20

# --- Round 2 visual inspection (optional; defaults shown as comments) ---
# Redis broker for batch inspections (Celery). Default: redis://localhost:6379/0
CELERY_BROKER_URL=
# Labeled samples scored by `manage.py evaluate_samples`. Default: <repo>/challenge-pack-r2/Samples
INSPECTION_SAMPLES_DIR=
# Report written by evaluate_samples and served by /api/inspections/metrics/. Default: <MEDIA_ROOT>/metrics/inspection_metrics.json
INSPECTION_METRICS_FILE=

# --- Demo users (manage.py seed_demo). Empty = a random password is generated and printed once. ---
DEMO_ADMIN_PASSWORD=
DEMO_ENGINEER_PASSWORD=
DEMO_ENGINEER2_PASSWORD=
DEMO_SUPERVISOR_PASSWORD=

# --- RAG engine (read by rag/config.py; defaults shown) ---
RAG_CHUNK_SIZE_WORDS=180
RAG_CHUNK_OVERLAP_WORDS=30
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_DIR=
CHROMA_DIR=
CHROMA_COLLECTION=manual_chunks
RAG_TOP_K=8
RAG_MAX_DISTANCE=0.80
RAG_MAX_CORRECTIONS=1

# --- LLM provider (rag/generation/llm_client.py). Empty = no provider (answers return "error"). ---
LLM_PROVIDER=groq
GROQ_API_KEY=<your-groq-api-key>
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=30
