# INDUSTRIX AI — environment variable template.
# Copy to .env (git-ignored) and fill in locally. Never commit real values or secrets.
# Every variable below is optional; the values shown are the defaults.

# --- RAG engine: chunking (rag/config.py) ---
# Chunk size and overlap in words. Overlap must be smaller than size.
RAG_CHUNK_SIZE_WORDS=180
RAG_CHUNK_OVERLAP_WORDS=30

# --- RAG engine: embeddings (rag/config.py) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
# Model cache directory. Empty = Hugging Face default (~/.cache/huggingface).
EMBEDDING_CACHE_DIR=
# Set to 1 after the model is cached to forbid network access (Hugging Face setting).
# HF_HUB_OFFLINE=1

# --- RAG engine: vector store (rag/config.py) ---
# Empty CHROMA_DIR = <project root>/chroma_db (git-ignored).
CHROMA_DIR=
CHROMA_COLLECTION=manual_chunks

# --- RAG engine: answer generation (rag/config.py) ---
RAG_TOP_K=8
# Max cosine distance for a passage to be sent to the LLM; "off" disables. Provisional value,
# see docs/PROJECT_ARCHITECTURE.md "Threshold tuning".
RAG_MAX_DISTANCE=0.80
RAG_MAX_CORRECTIONS=1

# --- LLM provider (rag/generation/llm_client.py) ---
# Empty LLM_PROVIDER = no provider; answers return status "provider_unavailable".
# No provider adapter is implemented yet (provider not announced). Never commit a real key.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30

# Django variables are added in the Django phase; see docs/PROJECT_ARCHITECTURE.md §9.
