# --- secrets / local environment ---
.env
.env.*
!.env.example

# --- Python virtual environments ---
venv/
.venv/

# --- Python bytecode and tool caches ---
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# --- generated data (rebuildable) ---
# ChromaDB vector index (rebuilt from the manuals)
chroma_db/
# Django uploaded files (MEDIA_ROOT)
media/
# temporary uploads / scratch files
tmp/
uploads/
*.tmp

# --- logs ---
logs/
*.log

# --- editor / OS / personal tooling ---
.idea/
.vscode/
.DS_Store
# Serena coding-assistant config (personal tooling, not required by the team)
.serena/

# --- challenge pack: share only what the tests need ---
# Keep: the three equipment manuals + machine_manual_index.csv (read by rag/tests and rag.evaluation).
# Exclude: challenge brief (PDF/DOCX), START_HERE.txt, duplicate ZIP, accidental README copy.
challenge-pack/*
!challenge-pack/Manuals/
!challenge-pack/machine_manual_index.csv

# --- Round 2 pack: commit only what the app and tests read, byte-identical to the pack ---
# Model/ is loaded unchanged by backend/inspections/ai_adapter.py; Samples/ feed evaluate_samples;
# Validation/ feeds the invalid-upload tests. Brief, guide and START_HERE stay local.
challenge-pack-r2/*
!challenge-pack-r2/Model/
!challenge-pack-r2/Samples/
!challenge-pack-r2/Validation/
!challenge-pack-r2/product_details.csv
!challenge-pack-r2/SHA256SUMS.txt
